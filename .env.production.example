# Copy to .env on the VPS (it is ignored by git) and fill in every value.

# Random password for PostgreSQL. Generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Public address of the store, with https and no trailing slash.
PUBLIC_ORIGIN=https://xpandertienda.duckdns.org

# WhatsApp number that receives the orders: country code and number, digits only.
# Example for Bolivia: 591 followed by the 8-digit mobile number.
ORDER_WHATSAPP_NUMBER=

# Upload limit for images, logos and QR codes from the panel, in GB. The VPS disk
# is shared with other applications; keep it well below the free space.
MEDIA_QUOTA_GB=40

# Lets plain "docker compose" commands use the production stack.
# If Caddy runs in Docker, use instead:
#   COMPOSE_FILE=compose.prod.yaml:compose.prod.caddy-docker.yaml
# and set CADDY_NETWORK to the name of the Caddy container's network.
COMPOSE_FILE=compose.prod.yaml
CADDY_NETWORK=

# Ports on 127.0.0.1 for a Caddy installed as a system service. Change them only
# if another application on the VPS already uses them.
XPANDER_WEB_PORT=13000
XPANDER_API_PORT=18080
